NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# CARTO's raster basemap tiles require a free API key (fair use: 5M tile
# requests/month) — request one at carto.com/basemaps/apikey. Without it,
# tiles still load but are watermarked "API KEY REQUIRED".
NEXT_PUBLIC_CARTO_API_KEY=your-carto-basemaps-api-key

# Server-only — never prefix with NEXT_PUBLIC_. Used by /admin and its API
# routes (app/api/admin/**) to review/approve/reject submitted spots.
# Get the service_role key from Supabase: Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=choose-a-strong-password
